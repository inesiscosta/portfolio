{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "predev": "node scripts/ensure-content.ts",
    "dev": "vite dev",
    "prebuild": "node scripts/ensure-content.ts",
    "build": "vite build && pagefind --site .svelte-kit/cloudflare && node scripts/og-screenshots.ts",
    "prepare": "svelte-kit sync || echo ''",
    "tsc": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "preview": "pnpm build && wrangler dev",
    "predeploy": "pnpm tsc && biome ci .",
    "deploy": "pnpm build && wrangler deploy",
    "upgrade-packages": "ncu --upgrade && pnpm install",
    "photo:add": "node scripts/r2.ts photo:add",
    "photo:rm": "node scripts/r2.ts photo:rm",
    "cv:push": "node scripts/r2.ts cv:push"
  },
  "dependencies": {
    "one-terminal": "^2.0.0",
    "party-js": "2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lucide/svelte": "^1.68.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "js-yaml": "^5.5.0",
    "katex": "^0.13.24",
    "mdsvex": "0.12.8",
    "npm-check-updates": "^22.2.9",
    "pagefind": "^1.6.0",
    "rehype-katex": "^5.0.0",
    "rehype-slug": "^4.0.1",
    "remark-math": "^3.0.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "simple-icons": "^16.36.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.156.0",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
